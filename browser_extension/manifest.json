{
  "manifest_version": 3,
  "name": "Focus Pet Bridge",
  "version": "0.2.0",
  "description": "上报活动标签页给 Focus Pet（本地），并拦截黑名单网站（支持白名单特例与教宠物）。",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:18765/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Focus Pet",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:18765;"
  }
}